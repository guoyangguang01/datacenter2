<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SdnCustom.Server.App.ViewModels"
        xmlns:controls="using:SdnCustom.Server.App.Controls"
        x:Class="SdnCustom.Server.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1518" Height="920" MinWidth="1180" MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="虚实数据交互工具（Simureal Data Nexus, SDN） - 数据中枢">
  <Grid RowDefinitions="116,*,220" ColumnDefinitions="286,*">
    <Border Grid.ColumnSpan="2">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="#073B78" />
          <GradientStop Offset="0.58" Color="#0B5CAD" />
          <GradientStop Offset="1" Color="#147AC8" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid RowDefinitions="48,*">
        <DockPanel Margin="18,0">
          <Border Width="34" Height="34" CornerRadius="9" Background="#24FFFFFF"
                  BorderBrush="#42FFFFFF" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock Text="SDN" Foreground="White" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="虚实数据交互工具" Foreground="White" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Simureal Data Nexus · 数据中枢" Foreground="#B9D8F5" FontSize="11" />
          </StackPanel>
          <Border DockPanel.Dock="Right" Background="#20FFFFFF" BorderBrush="#36FFFFFF"
                  BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="7" Height="7" Fill="#72E3AE" VerticalAlignment="Center"
                       IsVisible="{Binding HasOnlineClients}" />
              <Ellipse Width="7" Height="7" Fill="#A8D8FF" VerticalAlignment="Center"
                       IsVisible="{Binding HasNoOnlineClients}" />
              <TextBlock Text="{Binding OnlineClients, StringFormat='在线客户端 {0}'}"
                         Foreground="White" FontSize="12" />
            </StackPanel>
          </Border>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,0,2" Spacing="3">
          <Button Classes="ribbon" Click="OpenSystemSettings_OnClick">
            <StackPanel>
              <TextBlock Text="♙" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="系统设置" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Click="OpenClientManagement_OnClick">
            <StackPanel>
              <TextBlock Text="♟" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="用户管理" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Click="ShowDataView_OnClick">
            <StackPanel>
              <TextBlock Text="▥" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="数据视图" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Click="ShowSimulation_OnClick">
            <StackPanel>
              <TextBlock Text="◇" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="数据模拟" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="HistoryNavButton" Classes="ribbon" Click="ShowHistory_OnClick">
            <StackPanel>
              <TextBlock Text="▤" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="历史数据" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="LogNavButton" Classes="ribbon" Click="FocusLogs_OnClick">
            <StackPanel>
              <TextBlock Text="▦" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="运行日志" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Command="{Binding StartClientCommand}">
            <StackPanel>
              <TextBlock Text="●" FontSize="29" Foreground="#B9F3D8" HorizontalAlignment="Center" />
              <TextBlock Text="启动通讯" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Command="{Binding StopClientCommand}">
            <StackPanel>
              <TextBlock Text="⏻" FontSize="29" Foreground="#FFD4D4" HorizontalAlignment="Center" />
              <TextBlock Text="停止通讯" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Command="{Binding RefreshNowCommand}">
            <StackPanel>
              <TextBlock Text="⟳" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="刷新数据" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="ribbon" Click="OpenHelp_OnClick">
            <StackPanel>
              <TextBlock Text="?" FontSize="29" HorizontalAlignment="Center" />
              <TextBlock Text="帮助" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="10,10,5,5">
      <Grid RowDefinitions="42,*">
        <Border Classes="tableHeader" Padding="12,0">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="系统监视器" Classes="h2" />
            <Border Background="{DynamicResource BrandLightBrush}" CornerRadius="8" Padding="7,2">
              <TextBlock Text="{Binding TotalPoints, StringFormat='{}{0} 点'}"
                         Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="11" />
            </Border>
          </StackPanel>
        </Border>
        <TreeView Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="6">
          <TreeViewItem Header="仿真系统" IsExpanded="True">
            <TreeViewItem Header="虚拟操作" />
            <TreeViewItem Header="自定义视图" />
            <TreeViewItem Header="客户端系统" IsExpanded="True">
              <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClientRowViewModel">
                    <StackPanel>
                      <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ClientCode}" FontSize="11" Foreground="#526171" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding OnlineText}" FontSize="11" Foreground="#2E7D55" />
                        <TextBlock Text="{Binding CommunicationText}" FontSize="11" Foreground="#526171" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </TreeViewItem>
          </TreeViewItem>
        </TreeView>
      </Grid>
    </Border>

    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Grid.Column="1" Margin="5,10,10,5">
      <TabItem Header="数据视图">
        <Grid Margin="4" RowDefinitions="34,*">
          <Border Classes="toolbar">
            <DockPanel>
              <TextBlock Text="数据视图" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding OperationMessage}" Foreground="#526171"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,5,0,0">
            <Border Classes="panel" Margin="0,0,4,0">
              <Grid RowDefinitions="34,30,*">
                <Border Classes="tableHeader" Padding="12,0">
                  <TextBlock Text="软件输入数据" FontWeight="SemiBold" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="1.5*,2*,0.8*,0.8*,1.2*,0.9*"
                      Background="{DynamicResource SurfaceMutedBrush}">
                  <TextBlock Text="测点 ID" Margin="7,6" />
                  <TextBlock Grid.Column="1" Text="名称" Margin="7,6" />
                  <TextBlock Grid.Column="2" Text="类型" Margin="7,6" />
                  <TextBlock Grid.Column="3" Text="单位" Margin="7,6" />
                  <TextBlock Grid.Column="4" Text="最新值" Margin="7,6" />
                  <TextBlock Grid.Column="5" Text="质量" Margin="7,6" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding InputPoints}" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PointRowViewModel">
                      <Grid ColumnDefinitions="1.5*,2*,0.8*,0.8*,1.2*,0.9*" Margin="3,7">
                        <TextBlock Text="{Binding PointId}" />
                        <TextBlock Grid.Column="1" Text="{Binding PointName}" />
                        <TextBlock Grid.Column="2" Text="{Binding DataType}" />
                        <TextBlock Grid.Column="3" Text="{Binding Unit}" />
                        <TextBlock Grid.Column="4" Text="{Binding ValueText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="{Binding QualityText}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="panel" Margin="4,0,0,0">
              <Grid RowDefinitions="34,30,*">
                <Border Classes="tableHeader" Padding="12,0">
                  <TextBlock Text="输出分发数据" FontWeight="SemiBold" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="1.5*,2*,0.8*,0.8*,1.2*,0.9*"
                      Background="{DynamicResource SurfaceMutedBrush}">
                  <TextBlock Text="测点 ID" Margin="7,6" />
                  <TextBlock Grid.Column="1" Text="名称" Margin="7,6" />
                  <TextBlock Grid.Column="2" Text="类型" Margin="7,6" />
                  <TextBlock Grid.Column="3" Text="单位" Margin="7,6" />
                  <TextBlock Grid.Column="4" Text="最新值" Margin="7,6" />
                  <TextBlock Grid.Column="5" Text="质量" Margin="7,6" />
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding OutputPoints}" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PointRowViewModel">
                      <Grid ColumnDefinitions="1.5*,2*,0.8*,0.8*,1.2*,0.9*" Margin="3,7">
                        <TextBlock Text="{Binding PointId}" />
                        <TextBlock Grid.Column="1" Text="{Binding PointName}" />
                        <TextBlock Grid.Column="2" Text="{Binding DataType}" />
                        <TextBlock Grid.Column="3" Text="{Binding Unit}" />
                        <TextBlock Grid.Column="4" Text="{Binding ValueText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="{Binding QualityText}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="实物数据模拟">
        <Grid Margin="4" RowDefinitions="72,*">
          <Border Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel>
                <TextBlock Text="当前模拟用户" FontSize="12" />
                <TextBlock Text="{Binding SelectedClient.ClientName}" FontWeight="SemiBold" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="数据用户" FontSize="12" />
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Width="150"
                          IsEnabled="{Binding IsSimulationConfigurationEnabled}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="模拟频率(ms)" FontSize="12" />
                <NumericUpDown Value="{Binding SimulationIntervalMilliseconds}"
                               Minimum="50" Maximum="60000" Increment="50" Width="110"
                               IsEnabled="{Binding IsSimulationConfigurationEnabled}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="当前输出测点" FontSize="12" />
                <ComboBox ItemsSource="{Binding OutputPoints}" SelectedItem="{Binding SelectedPoint}" Width="170"
                          IsEnabled="{Binding IsSimulationConfigurationEnabled}" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="模拟值" FontSize="12" />
                <TextBox Text="{Binding WriteValue}" Width="130"
                         IsEnabled="{Binding IsSimulationConfigurationEnabled}" />
              </StackPanel>
              <Button Content="写入一次" Command="{Binding WritePointCommand}" VerticalAlignment="Bottom"
                      Padding="16,7" />
              <Button Classes="primary" Content="{Binding SimulationButtonText}"
                      Command="{Binding ToggleSimulationCommand}" VerticalAlignment="Bottom" Padding="18,7" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Classes="panel" Margin="0,6,0,0">
            <Grid RowDefinitions="32,*">
              <Grid ColumnDefinitions="1.4*,2*,0.8*,0.8*,1.2*,1.1*"
                    Background="{DynamicResource SurfaceMutedBrush}">
                <TextBlock Text="测点 ID" Margin="7,7" />
                <TextBlock Grid.Column="1" Text="名称" Margin="7,7" />
                <TextBlock Grid.Column="2" Text="类型" Margin="7,7" />
                <TextBlock Grid.Column="3" Text="单位" Margin="7,7" />
                <TextBlock Grid.Column="4" Text="最新值" Margin="7,7" />
                <TextBlock Grid.Column="5" Text="更新时间" Margin="7,7" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding OutputPoints}" SelectedItem="{Binding SelectedPoint}" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PointRowViewModel">
                    <Grid ColumnDefinitions="1.4*,2*,0.8*,0.8*,1.2*,1.1*" Margin="4,8">
                      <TextBlock Text="{Binding PointId}" />
                      <TextBlock Grid.Column="1" Text="{Binding PointName}" />
                      <TextBlock Grid.Column="2" Text="{Binding DataType}" />
                      <TextBlock Grid.Column="3" Text="{Binding Unit}" />
                      <TextBlock Grid.Column="4" Text="{Binding ValueText}" />
                      <TextBlock Grid.Column="5" Text="{Binding TimestampText}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="历史数据查询">
        <Grid Margin="4" RowDefinitions="92,*">
          <Border Classes="toolbar">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="数据用户" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Width="160" />
                <TextBlock Text="开始时间" VerticalAlignment="Center" />
                <TextBox Text="{Binding HistoryFrom}" Width="175" />
                <TextBlock Text="结束时间" VerticalAlignment="Center" />
                <TextBox Text="{Binding HistoryTo}" Width="175" />
                <TextBlock Text="单次上限" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding HistoryLimit}" Minimum="1" Maximum="10000" Width="105" />
                <Button Classes="primary" Content="查询" Command="{Binding QueryHistoryCommand}"
                        Padding="18,5" />
                <Button Classes="subtle" Content="清除条件" Command="{Binding ResetHistoryFilterCommand}"
                        Padding="14,5" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}" Width="240" />
                <Button Classes="primary" Content="绘制图表" Click="DrawChart_OnClick"
                        Padding="14,5" />
                <TextBlock Text="{Binding OperationMessage}" VerticalAlignment="Center" Foreground="#53687A" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Classes="panel" Margin="0,6,0,0">
            <controls:HistoryLineChart x:Name="HistoryChart" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*" Margin="10,5,10,10">
      <Border x:Name="LogPanel" Classes="panel" Margin="0,0,4,0">
        <Grid RowDefinitions="31,*">
          <Border Classes="tableHeader" Padding="12,0">
            <DockPanel>
              <TextBlock Text="日志" FontWeight="SemiBold" />
              <Button Classes="subtle" DockPanel.Dock="Right" Content="清空视图"
                      Command="{Binding ClearLogsCommand}" Padding="10,2" />
            </DockPanel>
          </Border>
          <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="panel" Margin="4,0,0,0">
        <Grid RowDefinitions="31,34,*">
          <Border Classes="tableHeader" Padding="12,0">
            <TextBlock Text="通讯状态" FontWeight="SemiBold" />
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="1.4*,1.8*,1*,1.8*,90,90"
                Background="{DynamicResource SurfaceMutedBrush}">
            <TextBlock Text="客户端 ID" Margin="8,7" />
            <TextBlock Grid.Column="1" Text="名称" Margin="8,7" />
            <TextBlock Grid.Column="2" Text="协议" Margin="8,7" />
            <TextBlock Grid.Column="3" Text="设备地址" Margin="8,7" />
            <TextBlock Grid.Column="4" Text="连接" Margin="8,7" />
            <TextBlock Grid.Column="5" Text="通讯" Margin="8,7" />
          </Grid>
          <ListBox Grid.Row="2" ItemsSource="{Binding Clients}" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ClientRowViewModel">
                <Grid ColumnDefinitions="1.4*,1.8*,1*,1.8*,90,90" Margin="0,3">
                  <TextBlock Text="{Binding ClientCode}" Margin="10,3" />
                  <TextBlock Grid.Column="1" Text="{Binding ClientName}" Margin="8,3" />
                  <TextBlock Grid.Column="2" Text="{Binding Protocol}" Margin="8,3" />
                  <TextBlock Grid.Column="3" Text="{Binding Endpoint}" Margin="8,3" />
                  <TextBlock Grid.Column="4" Text="{Binding OnlineText}" Margin="8,3" />
                  <TextBlock Grid.Column="5" Text="{Binding CommunicationText}" Margin="8,3" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
