<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SdnCustom.Server.App.ViewModels"
        x:Class="SdnCustom.Server.App.Views.ClientManagementWindow"
        x:DataType="vm:ClientManagementViewModel"
        Width="1400" Height="820" MinWidth="1080" MinHeight="650"
        Background="#F1F1F1"
        Title="用户管理">
  <Grid RowDefinitions="42,*,30">
    <Border Background="#0B56A4">
      <TextBlock Text="用户管理" Foreground="White" FontSize="20" FontWeight="Bold" Margin="12,7" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="285,*" Margin="10">
      <Border BorderBrush="#C4CDD6" BorderThickness="1" Background="White" Margin="0,0,8,0">
        <Grid RowDefinitions="Auto,Auto,36,*" Margin="10">
          <StackPanel Spacing="7">
            <TextBlock Text="系统设置：" FontWeight="SemiBold" />
            <TextBlock Text="系统选择：" />
            <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                      ItemTemplate="{x:Null}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientOption">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="新增客户端：" FontWeight="SemiBold" />
            <TextBox Text="{Binding NewClientCode}" Watermark="客户端代码" />
            <TextBox Text="{Binding NewClientName}" Watermark="客户端名称" />
            <Button Content="＋ 创建客户端" Command="{Binding CreateClientCommand}"
                    Background="#159EF5" Foreground="White" />
          </StackPanel>
          <Border Grid.Row="2" Background="#F5F7F9" BorderBrush="#D3DBE3" BorderThickness="0,1,0,1"
                  Margin="0,12,0,0">
            <TextBlock Text="仿真系统 / 客户端系统" Margin="8,8" FontWeight="SemiBold" />
          </Border>
          <TreeView Grid.Row="3" BorderThickness="0">
            <TreeViewItem Header="仿真系统" IsExpanded="True">
              <TreeViewItem Header="客户端系统" IsExpanded="True">
                <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                         BorderThickness="0" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClientOption">
                      <StackPanel>
                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Online, StringFormat='在线：{0}'}"
                                   FontSize="11" Foreground="#587084" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </TreeViewItem>
              <TreeViewItem Header="虚拟操作" />
            </TreeViewItem>
          </TreeView>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="46,*">
        <DockPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="＋ 新增测点" Command="{Binding AddPointCommand}"
                    IsEnabled="{Binding CanEditPoints}"
                    Background="#159EF5" Foreground="White" Padding="12,5" />
            <Button Content="－ 删除测点" Command="{Binding RemovePointCommand}"
                    IsEnabled="{Binding CanEditPoints}"
                    Background="#ED684F" Foreground="White" Padding="12,5" />
            <Button Content="⇩ 所有输出测点下载" Click="ExportOutputs_OnClick"
                    Background="#0B56A4" Foreground="White" Padding="10,5" />
            <Button Content="⇧ 导出数据源总表" Click="ExportAll_OnClick"
                    Background="#0B56A4" Foreground="White" Padding="10,5" />
            <Button Content="⇩ 导入数据源总表" Click="Import_OnClick"
                    IsEnabled="{Binding CanEditPoints}"
                    Background="#159EF5" Foreground="White" Padding="10,5" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="保存" Command="{Binding SavePointsCommand}"
                    IsEnabled="{Binding CanEditPoints}"
                    Background="#159EF5" Foreground="White" Width="88" />
            <Button Content="取消" Command="{Binding CancelChangesCommand}"
                    Background="#159EF5" Foreground="White" Width="88" />
          </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint}"
                  AutoGenerateColumns="False" IsReadOnly="{Binding IsPointsReadOnly}"
                  CanUserReorderColumns="False" CanUserResizeColumns="True"
                  GridLinesVisibility="All" HeadersVisibility="Column"
                  FrozenColumnCount="2" RowHeight="38">
          <DataGrid.Columns>
            <DataGridTextColumn Header="测点ID" Width="140" Binding="{Binding PointId}" />
            <DataGridTextColumn Header="测点名称" Width="220" Binding="{Binding PointName}" />
            <DataGridTemplateColumn Header="类型" Width="105">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:EditablePointRow">
                  <ComboBox ItemsSource="{Binding DataTypeOptions}" SelectedItem="{Binding DataType}"
                            BorderThickness="0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="单位" Width="70" Binding="{Binding Unit}" />
            <DataGridTemplateColumn Header="方向" Width="105">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:EditablePointRow">
                  <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding Direction}"
                            BorderThickness="0" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="地址/参数" Width="170" Binding="{Binding Address}" />
            <DataGridTextColumn Header="引用 OUTPUT" Width="150" Binding="{Binding SourceOutputPointId}" />
            <DataGridTextColumn Header="死区" Width="80" Binding="{Binding Deadband}" />
            <DataGridTextColumn Header="分组" Width="110" Binding="{Binding Group}" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#E5EBF1" Padding="10,5">
      <TextBlock Text="{Binding StatusText}" />
    </Border>
  </Grid>
</Window>
