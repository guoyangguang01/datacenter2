<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SdnCustom.Server.App.ViewModels"
        x:Class="SdnCustom.Server.App.Views.ClientManagementWindow"
        x:DataType="vm:ClientManagementViewModel"
        Width="1480" Height="860" MinWidth="1180" MinHeight="720"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="用户管理">
  <Grid RowDefinitions="58,*,36">
    <Border Background="{DynamicResource BrandDarkBrush}">
      <DockPanel Margin="18,0">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="用户与测点管理" Foreground="White" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="维护客户端、INPUT 数据来源和 OUTPUT 分发点" Foreground="#B9D8F5" FontSize="11" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#20FFFFFF" BorderBrush="#36FFFFFF"
                BorderThickness="1" CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
          <TextBlock Text="{Binding ClientCountText}" Foreground="White" FontSize="12" />
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,*" Margin="14">
      <Border Classes="card" Margin="0,0,12,0" Padding="14">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <StackPanel Spacing="8">
            <TextBlock Text="当前系统" Classes="h2" />
            <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SystemOption">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding SystemName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Display}" Classes="caption" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
            <TextBlock Text="当前客户端" Classes="h2" />
            <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientOption">
                  <TextBlock Text="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="显示名称" Classes="muted" />
            <Grid ColumnDefinitions="*,88" ColumnSpacing="8">
              <TextBox Text="{Binding SelectedClientName}" IsEnabled="{Binding CanManageClient}"
                       Watermark="选择客户端后可修改名称" />
              <Button Grid.Column="1" Content="保存名称" Command="{Binding RenameClientCommand}" />
            </Grid>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14" />

          <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="新建客户端" Classes="h2" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <TextBox Text="{Binding NewClientCode}" Watermark="客户端代码" />
              <TextBox Grid.Column="1" Text="{Binding NewClientName}" Watermark="客户端名称" />
            </Grid>
            <TextBlock Text="{Binding SelectedSystem.SystemName, StringFormat='将创建到当前系统：{0}'}"
                       Classes="caption" IsVisible="{Binding HasSelectedSystem}" />
            <Button Classes="primary" Content="＋ 创建客户端" Command="{Binding CreateClientCommand}"
                    HorizontalAlignment="Stretch" />
          </StackPanel>

          <Grid Grid.Row="3" RowDefinitions="44,*" Margin="0,16,0,0">
            <DockPanel>
              <TextBlock Text="客户端列表" Classes="section" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding ClientCountText}" Classes="caption"
                         VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="1">
              <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                       BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClientOption">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,5">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ClientCode}" Classes="caption" />
                      </StackPanel>
                      <Border Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"
                              CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Online, StringFormat='在线 {0}'}"
                                   Classes="caption" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel IsVisible="{Binding HasNoClients}" VerticalAlignment="Center"
                          HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="暂无客户端" Classes="h2" HorizontalAlignment="Center" />
                <TextBlock Text="填写上方代码和名称开始创建" Classes="muted" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="64,46,46,*">
        <Border Classes="card" Padding="14,10">
          <DockPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding SelectedClient.ClientName, FallbackValue='尚未选择客户端'}"
                         Classes="h2" />
              <TextBlock Text="{Binding SelectedClientStateText}" Classes="muted" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
              <Border Background="{DynamicResource BrandLightBrush}" CornerRadius="9" Padding="10,4">
                <TextBlock Text="{Binding Points.Count, StringFormat='{}{0} 个测点'}"
                           Foreground="{DynamicResource BrandPrimaryBrush}" FontSize="12" />
              </Border>
              <TextBlock Text="{Binding StatusText}" Classes="muted" VerticalAlignment="Center"
                         MaxWidth="310" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="toolbar" Margin="0,8,0,6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Content="刷新" Command="{Binding RefreshCommand}" />
              <Button Classes="danger" Content="－ 删除客户端" Click="DeleteClient_OnClick"
                      IsEnabled="{Binding CanManageClient}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="toolbar" Margin="0,0,0,6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Content="导入燃气表" Click="ImportGasMaster_OnClick"
                      IsEnabled="{Binding HasSelectedSystem}" />
              <Button Content="导出燃气表" Click="ExportGasMaster_OnClick"
                      IsEnabled="{Binding HasSelectedSystem}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="点表由燃气总表导入维护" Classes="muted"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="3" Classes="panel">
          <Grid>
            <DataGrid ItemsSource="{Binding FilteredPoints}" SelectedItem="{Binding SelectedPoint}"
                      IsVisible="{Binding ShowPoints}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserReorderColumns="False" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      FrozenColumnCount="2" RowHeight="40">
              <DataGrid.Columns>
                <DataGridTextColumn Header="测点 ID" Width="1.15*" MinWidth="110" Binding="{Binding PointId}" />
                <DataGridTextColumn Header="测点名称" Width="1.8*" MinWidth="170" Binding="{Binding PointName}" />
                <DataGridTextColumn Header="类型" Width="110" Binding="{Binding DataType}" />
                <DataGridTextColumn Header="单位" Width="82" Binding="{Binding Unit}" />
                <DataGridTextColumn Header="方向" Width="90" Binding="{Binding DirectionDisplay}" />
                <DataGridTextColumn Header="地址/参数" Width="1.3*" MinWidth="130" Binding="{Binding Address}" />
                <DataGridTextColumn Header="死区" Width="82" Binding="{Binding Deadband}" />
                <DataGridTextColumn Header="分组" Width="110" Binding="{Binding Group}" />
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel IsVisible="{Binding ShowNoClientState}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="10">
              <Border Width="54" Height="54" CornerRadius="27"
                      Background="{DynamicResource BrandLightBrush}" HorizontalAlignment="Center">
                <TextBlock Text="＋" FontSize="28" Foreground="{DynamicResource BrandPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="先创建或选择一个客户端" Classes="h2" HorizontalAlignment="Center" />
              <TextBlock Text="客户端创建后，可通过燃气总表导入测点目录"
                         Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowNoPointsState}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="10">
              <Border Width="54" Height="54" CornerRadius="27"
                      Background="{DynamicResource BrandLightBrush}" HorizontalAlignment="Center">
                <TextBlock Text="≡" FontSize="25" Foreground="{DynamicResource BrandPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="当前客户端还没有测点" Classes="h2" HorizontalAlignment="Center" />
              <TextBlock Text="通过燃气总表导入该客户端的 INPUT 端点"
                         Classes="muted" HorizontalAlignment="Center" />
              <Button Classes="primary" Content="导入燃气表" Click="ImportGasMaster_OnClick"
                      IsEnabled="{Binding HasSelectedSystem}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowNoFilteredPoints}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="当前分类暂无测点" Classes="h2" HorizontalAlignment="Center" />
              <TextBlock Text="切换到“全部”，或新增该分类的测点"
                         Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,8">
      <TextBlock Text="{Binding StatusText}" Classes="muted" />
    </Border>
  </Grid>
</Window>
