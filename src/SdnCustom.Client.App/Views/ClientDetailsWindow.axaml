<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SdnCustom.Client.App.ViewModels"
        x:Class="SdnCustom.Client.App.Views.ClientDetailsWindow"
        x:DataType="vm:ClientViewModel"
        Width="500" Height="330" CanResize="False"
        Background="#F1F1F1"
        Title="详细设置">
  <Grid RowDefinitions="42,*,62">
    <Border Background="#0B56A4">
      <TextBlock Text="详细设置" Foreground="White" FontSize="20" FontWeight="Bold"
                 Margin="12,7" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="170,150,150" RowDefinitions="52,42,42,42"
          Margin="30,18,22,8">
      <TextBlock Grid.Column="1" Text="中心发往用户" FontSize="16" HorizontalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="用户发往中心" FontSize="16" HorizontalAlignment="Center" />

      <TextBlock Grid.Row="1" Text="发送频率：" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="5"
                  HorizontalAlignment="Center">
        <NumericUpDown Value="{Binding CenterToUserFrequencyMilliseconds}"
                       Minimum="20" Maximum="60000" Increment="50" Width="100" />
        <TextBlock Text="ms" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="5"
                  HorizontalAlignment="Center">
        <NumericUpDown Value="{Binding UserToCenterFrequencyMilliseconds}"
                       Minimum="20" Maximum="60000" Increment="50" Width="100" />
        <TextBlock Text="ms" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Grid.Row="2" Text="允许缺项：" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding AllowCenterToUserMissingItems}"
                HorizontalAlignment="Center" />
      <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding AllowUserToCenterMissingItems}"
                HorizontalAlignment="Center" />

      <TextBlock Grid.Row="3" Text="数据变化时发送：" VerticalAlignment="Center" HorizontalAlignment="Right" />
      <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SendCenterToUserOnChange}"
                HorizontalAlignment="Center" />
      <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding SendUserToCenterOnChange}"
                HorizontalAlignment="Center" />
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                VerticalAlignment="Center" Spacing="24">
      <Button Content="确定" Width="100" Click="SaveAndClose_OnClick" />
      <Button Content="取消" Width="100" Click="Cancel_OnClick" />
    </StackPanel>
  </Grid>
</Window>
