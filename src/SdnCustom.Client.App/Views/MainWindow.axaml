<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SdnCustom.Client.App.ViewModels"
        x:Class="SdnCustom.Client.App.Views.MainWindow"
        x:DataType="vm:ClientViewModel"
        Width="1360" Height="800" MinWidth="1180" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="数据用户 - 单连接客户端 - 实时通讯">
  <Grid RowDefinitions="62,174,*,196">
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
          <GradientStop Offset="0" Color="#073B78" />
          <GradientStop Offset="0.62" Color="#0B5CAD" />
          <GradientStop Offset="1" Color="#147AC8" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel Margin="18,0">
        <Border Width="34" Height="34" CornerRadius="9" Background="#24FFFFFF"
                BorderBrush="#42FFFFFF" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock Text="SDN" Foreground="White" FontSize="10" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding ClientName, StringFormat='数据用户 · {0}'}"
                     Foreground="White" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="单连接客户端 · 实时通讯" Foreground="#B9D8F5" FontSize="11" />
        </StackPanel>
        <Border DockPanel.Dock="Right" Background="#20FFFFFF" BorderBrush="#36FFFFFF"
                BorderThickness="1" CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="#72E3AE" VerticalAlignment="Center"
                     IsVisible="{Binding IsServerConnected}" />
            <Ellipse Width="7" Height="7" Fill="#FFD4D4" VerticalAlignment="Center"
                     IsVisible="{Binding IsServerDisconnected}" />
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="10,8,10,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Classes="card" Margin="0,0,5,0" Padding="14">
        <Grid ColumnDefinitions="58,*,34,68,92" RowDefinitions="28,34,34"
              ColumnSpacing="6">
          <TextBlock Grid.ColumnSpan="5" Text="数据中心设置" Classes="h2" />
          <TextBlock Grid.Row="1" Text="IP" Classes="muted" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerHost}"
                   IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="端口" Classes="muted"
                     VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ServerPort}"
                   IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <Button Grid.Row="1" Grid.Column="4" Classes="primary"
                  Content="{Binding ServerConnectionButtonText}" Command="{Binding ToggleServerCommand}" />
          <TextBlock Grid.Row="2" Text="TLS" Classes="muted" VerticalAlignment="Center" />
          <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="安全连接"
                    IsChecked="{Binding UseTls}"
                    IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <Button Grid.Row="2" Grid.Column="3" Content="保存" Command="{Binding SaveCommand}" />
          <Button Grid.Row="2" Grid.Column="4" Content="重载" Command="{Binding ReloadCommand}" />
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" Margin="5,0" Padding="14">
        <Grid ColumnDefinitions="96,*" RowDefinitions="28,34,34" ColumnSpacing="8">
          <TextBlock Grid.ColumnSpan="2" Text="数据用户设置" Classes="h2" />
          <TextBlock Grid.Row="1" Text="客户端名称" Classes="muted" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientName}"
                   IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <TextBlock Grid.Row="2" Text="通讯协议" Classes="muted" VerticalAlignment="Center" />
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,92" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding ProtocolOptions}" SelectedItem="{Binding Protocol}"
                      IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
            <Button Grid.Column="1" Classes="primary" Content="连接"
                    Command="{Binding ConnectServerCommand}" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card" Margin="5,0,0,0" Padding="14">
        <Grid ColumnDefinitions="44,*,32,56,76,76" RowDefinitions="28,34,34"
              ColumnSpacing="6">
          <TextBlock Grid.ColumnSpan="6" Text="实时通讯设置" Classes="h2" />
          <TextBlock Grid.Row="1" Text="设备 IP" Classes="muted" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DeviceHost}"
                   IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="端口" Classes="muted"
                     VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding DevicePort}"
                   IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <Button Grid.Row="1" Grid.Column="4" Content="详细设置" Click="OpenDetails_OnClick" />
          <Button Grid.Row="1" Grid.Column="5" Classes="success" Content="启动"
                  Command="{Binding StartCommunicationCommand}" />
          <TextBlock Grid.Row="2" Text="代码" Classes="muted" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ClientCode}"
                   IsEnabled="{Binding IsConnectionConfigurationEnabled}" />
          <Button Grid.Row="2" Grid.Column="5" Classes="danger" Content="停止"
                  Command="{Binding StopCommunicationCommand}" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="10,0">
      <Border Classes="panel" Margin="0,0,5,0">
        <Grid RowDefinitions="48,*">
          <Border Classes="tableHeader" Padding="12,0">
            <DockPanel>
              <TextBlock Text="输入参数数据" Classes="h2" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="接收" />
                <TextBlock Text="{Binding InputPointCount, StringFormat='{}{0} 个'}"
                           Foreground="{DynamicResource BrandPrimaryBrush}" FontWeight="Bold" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" RowDefinitions="38,*">
            <Grid ColumnDefinitions="1.3*,2.2*,1.1*,0.8*,1*,1.3*"
                  Background="{DynamicResource SurfaceMutedBrush}" Margin="0">
              <TextBlock Text="测点ID" Margin="12,9" />
              <TextBlock Grid.Column="1" Text="名称" Margin="8,9" />
              <TextBlock Grid.Column="2" Text="数据" Margin="8,9" />
              <TextBlock Grid.Column="3" Text="单位" Margin="8,9" />
              <TextBlock Grid.Column="4" Text="质量" Margin="8,9" />
              <TextBlock Grid.Column="5" Text="更新时间" Margin="8,9" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding InputPoints}" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientPointRow">
                  <Grid ColumnDefinitions="1.3*,2.2*,1.1*,0.8*,1*,1.3*" Margin="0,7">
                    <TextBlock Text="{Binding PointId}" Margin="12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding PointName}" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Data}" Margin="8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="8,0" />
                    <TextBlock Grid.Column="4" Text="{Binding Quality}" Margin="8,0" />
                    <TextBlock Grid.Column="5" Text="{Binding Timestamp}" Margin="8,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel" Margin="5,0,0,0">
        <Grid RowDefinitions="48,*">
          <Border Classes="tableHeader" Padding="12,0">
            <DockPanel>
              <TextBlock Text="输出分发数据" Classes="h2" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="接收" />
                <TextBlock Text="{Binding OutputPointCount, StringFormat='{}{0} 个'}"
                           Foreground="{DynamicResource BrandPrimaryBrush}" FontWeight="Bold" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" RowDefinitions="38,*">
            <Grid ColumnDefinitions="1.3*,2.2*,1.1*,0.8*,1*,1.3*"
                  Background="{DynamicResource SurfaceMutedBrush}">
              <TextBlock Text="测点ID" Margin="12,9" />
              <TextBlock Grid.Column="1" Text="名称" Margin="8,9" />
              <TextBlock Grid.Column="2" Text="数据" Margin="8,9" />
              <TextBlock Grid.Column="3" Text="单位" Margin="8,9" />
              <TextBlock Grid.Column="4" Text="质量" Margin="8,9" />
              <TextBlock Grid.Column="5" Text="更新时间" Margin="8,9" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding OutputPoints}" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ClientPointRow">
                  <Grid ColumnDefinitions="1.3*,2.2*,1.1*,0.8*,1*,1.3*" Margin="0,7">
                    <TextBlock Text="{Binding PointId}" Margin="12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding PointName}" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Data}" Margin="8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding Unit}" Margin="8,0" />
                    <TextBlock Grid.Column="4" Text="{Binding Quality}" Margin="8,0" />
                    <TextBlock Grid.Column="5" Text="{Binding Timestamp}" Margin="8,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Classes="panel" Margin="10,7,10,10">
      <Grid RowDefinitions="34,*">
        <Border Classes="tableHeader" Padding="12,0">
          <DockPanel>
            <TextBlock Text="运行日志" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding OperationMessage}"
                       Foreground="#53687A" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
              <Button Classes="subtle" Content="清空日志" Command="{Binding ClearLogsCommand}" Padding="10,3" />
              <Button Content="通讯参数设置" Click="OpenDetails_OnClick" Padding="10,3" />
            </StackPanel>
          </DockPanel>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock FontFamily="Consolas" FontSize="12" Text="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</Window>
